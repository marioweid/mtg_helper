DATABASE_URL=postgresql://mtg:mtg_dev@localhost:5432/mtg_helper
OPENAI_API_KEY=your_openai_key_here
SCRYFALL_BULK_DATA_URL=https://api.scryfall.com/bulk-data
# Optional remote Assay tracing (includes AI prompts, responses, and tool content).
# Set all three, or leave all empty to disable. See OPERATIONS.md.
# Endpoint must be reachable from the backend container, e.g. http://homeserver:8080.
ASSAY_ENDPOINT=
# Project ingest key (asy_...), NOT the Assay admin token.
ASSAY_API_KEY=
# Existing application slug in that project, NOT its UUID.
ASSAY_APPLICATION=
# Shared secret for internal service-to-service calls to /api/v1/admin/*.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=
