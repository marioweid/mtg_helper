# Copy these into the Portainer stack environment variables. Do not commit real secrets.

# Host path on the Portainer/Docker host for persistent Postgres + Qdrant data.
MTG_HELPER_DATA_DIR=/srv/mtg-helper/data

# Existing reverse proxy / Cloudflare Tunnel should point to this host port.
FRONTEND_BIND_ADDR=127.0.0.1
FRONTEND_PORT=3001
# Next.js port inside the frontend container.
PORT=3001

POSTGRES_DB=mtg_helper
POSTGRES_USER=mtg
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Backend / AI
OPENAI_API_KEY=
SCRYFALL_BULK_DATA_URL=https://api.scryfall.com/bulk-data
# Optional remote Assay tracing (includes AI prompts, responses, and tool content).
# Set all three, or leave all empty to disable. Use a backend-reachable base URL.
ASSAY_ENDPOINT=
# Project ingest key (asy_...), NOT the Assay admin token.
ASSAY_API_KEY=
# Existing application slug in that project, NOT its UUID.
ASSAY_APPLICATION=
ENABLE_OPTIMIZER=false

# Google OAuth / NextAuth
# AUTH_URL must be the public origin, e.g. https://mtg.example.com
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
ADMIN_EMAILS=you@example.com

# Shared secret for the scryfall-sync container hitting /api/v1/admin/*.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=
