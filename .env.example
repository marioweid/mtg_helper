# Copy to .env. Never commit real values or print `docker compose config` with secrets.
# Use the same Google client for the frontend and backend.
# Allow this redirect in Google Cloud: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate a unique local secret, not the production Auth.js secret.
AUTH_SECRET=

# Optional unless using docker-compose.live.yml. Use a LAN-resolvable database host,
# not the homeserver's Docker-only PostgreSQL service/container hostname.
# WARNING: local edits/deletes use real production data. No migrations or test resets here.
LIVE_DATABASE_URL=
